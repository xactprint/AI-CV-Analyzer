PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret
CLIENT_URL=http://localhost:5173

# AI provider. Set ONE of the two keys below; with none of them the server
# falls back to the deterministic local analyser.
# Optional: "auto" (default) | "groq" | "xai" - force one provider.
AI_PROVIDER=auto

# Groq - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# xAI - https://console.x.ai  (alternative to Groq)
# XAI_API_KEY=your_xai_api_key
# XAI_MODEL=grok-4

# Optional. Only needed when your network resolver refuses SRV queries
# ("querySrv ECONNREFUSED" on a mongodb+srv:// connection).
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
